graph T {
  node [shape=box, style="rounded,filled", fontname="Latin Modern Sans", fontsize=16];
  edge [color="#555555"];
  b0 [label="{1, 2, 3, 5}", fillcolor="#e8eef6", color="#4673aa", penwidth=1.4];
  b1 [label="{5, 7, 8, 9}", fillcolor="#eeeeee", color="#777777", penwidth=1.4];
  b2 [label="{6, 7, 9, 10}", fillcolor="#eeeeee", color="#777777", penwidth=1.4];
  b3 [label="{1, 3, 4, 6}", fillcolor="#e8eef6", color="#4673aa", penwidth=1.4];
  b4 [label="{5, 6, 7, 9}", fillcolor="#e8eef6", color="#4673aa", penwidth=1.4];
  b5 [label="{1, 3, 5, 6}", fillcolor="#fbeedd", color="#e18c2b", penwidth=3];
  b5 -- b0;
  b5 -- b3;
  b5 -- b4;
  b4 -- b1;
  b4 -- b2;
}
