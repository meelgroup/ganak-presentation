flowchart LR
  A{{"component left<br/>at this level?"}}
  A -->|"not split yet"| B["split into components;<br/>cache hits: multiply in,<br/>misses: push"]
  B --> A
  A -->|yes| H([descend])
  A -->|"none left"| J["backtrack:<br/>branch₀ + branch₁"]
  H -.->|branch exhausted| J
  J --> L["store in cache,<br/>multiply into parent"]
  L --> A

  classDef dec fill:#e8eef6,stroke:#4673aa
  classDef cache fill:#fbeedd,stroke:#e18c2b
  classDef math fill:#e6f2e3,stroke:#59a14f
  class A,B dec
  class L cache
  class J,H math
