flowchart LR
  A{{"component left<br/>at this level?"}}
  A -->|"not split<br/>yet"| B("split into<br/>components")
  B -->|"now split"| A
  A -->|yes| H(descend)
  A -->|"none left"| J("backtrack:<br/>branch<sub>0</sub> + branch<sub>1</sub>")
  H -.->|"branch<br/>exhausted"| J
  J --> L("store in cache,<br/>multiply<br/>into parent")
  L -->|"parent level"| A

  %% blue: search, green: counting, orange: cache
  classDef search fill:#e8eef6,stroke:#4673aa
  classDef count fill:#e6f2e3,stroke:#59a14f
  classDef cache fill:#fbeedd,stroke:#e18c2b
  class B,H search
  class J count
  class L cache
